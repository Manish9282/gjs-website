{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      {
        "source": "http://gorrijewellers.com/:path*",
        "destination": "https://www.gorrijewellers.com/:path*",
        "type": 301
      },
      {
        "source": "http://www.gorrijewellers.com/:path*",
        "destination": "https://www.gorrijewellers.com/:path*",
        "type": 301
      },
      {
        "source": "https://gorrijewellers.com/:path*",
        "destination": "https://www.gorrijewellers.com/:path*",
        "type": 301
      }
    ]
  }
}